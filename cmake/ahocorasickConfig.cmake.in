@PACKAGE_INIT@

# Provides ahocorasick::core, carrying the module interface unit as source with
# the include directory and definitions needed to compile it.
#
# No find_dependency call, because the algorithm has no dependencies. One added
# later belongs here, or a consumer's configure fails on an undefined target.
include("${CMAKE_CURRENT_LIST_DIR}/ahocorasickTargets.cmake")

check_required_components(ahocorasick)
